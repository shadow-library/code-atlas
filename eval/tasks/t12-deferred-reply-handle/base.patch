+import { MetaStore } from '@corvid/meta';
+
+export const ENTRY_KEY = Symbol('corvid:entry');
+export const UNIT_ENTRY_KEY = Symbol('corvid:unit-entry');
+
+export function markEntry(options: object): MethodDecorator {
+  return (_target, _property, descriptor) => {
+    MetaStore.merge(ENTRY_KEY, options, descriptor.value as object);
+  };
+}
+
+export function markUnitEntry(options: object): ClassDecorator {
+  return target => MetaStore.merge(UNIT_ENTRY_KEY, options, target);
+}
