+import { Fetch, Payload, Reply, type ReplyHandle, Resource, Store } from '@corvid/web';
+
+import { FeedService } from './feed.service';
+
+@Resource()
+export class FeedController {
+  private readonly feeds = new FeedService();
+
+  @Fetch('/feeds/export')
+  async feedExport(@Reply() reply: ReplyHandle) {
+    const xml = await this.feeds.exportXml();
+    reply.send(xml, 'application/atom+xml');
+  }
+
+  @Fetch('/feeds/latest')
+  latest() {
+    return this.feeds.latest();
+  }
+
+  @Store('/feeds/subscribe')
+  subscribe(@Payload() payload: { url: string }) {
+    return { subscribers: this.feeds.subscribe(payload.url) };
+  }
+}
