+import { MetaStore } from '@corvid/meta';
+
+export const INPUT_SLOTS = Symbol('corvid:web:inputs');
+
+export type SlotKind = 'reply' | 'payload' | 'query' | 'header';
+
+export interface InputSlot {
+  index: number;
+  kind: SlotKind;
+  name?: string;
+}
+
+export function bindInput(kind: SlotKind, name?: string): ParameterDecorator {
+  return (target, property, index) => {
+    const method = (target as Record<string | symbol, object>)[property as string | symbol];
+    MetaStore.merge<InputSlot[]>(INPUT_SLOTS, [{ index, kind, name }], method);
+  };
+}
+
+export function ReplyParam(): ParameterDecorator {
+  return bindInput('reply');
+}
+
+export const Reply = ReplyParam;
+export const Payload = () => bindInput('payload');
+export const Query = (name: string) => bindInput('query', name);
+export const Header = (name: string) => bindInput('header', name);
