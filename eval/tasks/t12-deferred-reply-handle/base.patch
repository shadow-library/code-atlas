@@ -0,0 +1,23 @@
+const ENTRIES = [
+  { id: 'launch', title: 'Portal launch', updated: '2026-09-01' },
+  { id: 'export', title: 'Feed export', updated: '2026-09-20' },
+];
+
+export class FeedService {
+  private readonly subscribers: string[] = [];
+
+  async exportXml(): Promise<string> {
+    const items = ENTRIES.map(entry => `  <entry><id>${entry.id}</id><title>${entry.title}</title><updated>${entry.updated}</updated></entry>`);
+    return ['<?xml version="1.0" encoding="UTF-8"?>', '<feed xmlns="http://www.w3.org/2005/Atom">', ...items, '</feed>'].join('\n');
+  }
+
+  latest(): { id: string; title: string } {
+    const [first] = ENTRIES;
+    return { id: first.id, title: first.title };
+  }
+
+  subscribe(url: string): number {
+    this.subscribers.push(url);
+    return this.subscribers.length;
+  }
+}
