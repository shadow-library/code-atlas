@@ -0,0 +1,29 @@
+export type MetaKey = string | symbol;
+
+const bags = new WeakMap<object, Map<MetaKey, unknown>>();
+
+export class MetaStore {
+  static merge<T>(key: MetaKey, value: T, target: object): void {
+    const bag = bags.get(target) ?? new Map<MetaKey, unknown>();
+    bag.set(key, combine(bag.get(key), value));
+    bags.set(target, bag);
+  }
+
+  static read<T>(key: MetaKey, target: object): T | undefined {
+    return bags.get(target)?.get(key) as T | undefined;
+  }
+
+  static has(key: MetaKey, target: object): boolean {
+    return bags.get(target)?.has(key) ?? false;
+  }
+}
+
+function combine(current: unknown, value: unknown): unknown {
+  if (Array.isArray(current) && Array.isArray(value)) return [...current, ...value];
+  if (isRecord(current) && isRecord(value)) return { ...current, ...value };
+  return value;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
