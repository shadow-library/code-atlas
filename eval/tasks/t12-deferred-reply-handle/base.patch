--- /dev/null
+++ b/corvid/packages/web/src/web-router.ts
@@ -0,0 +1,77 @@
+import { type EntryBundle, Transport } from '@corvid/core';
+import { MetaStore } from '@corvid/meta';
+
+import { INPUT_SLOTS, type InputSlot } from './params';
+import { ReplyHandle, toWire, type WireReply, type WireRequest } from './reply';
+import { RESOURCE_KIND } from './resource.decorator';
+
+type Invoker = (request: WireRequest) => Promise<WireReply>;
+
+interface MountedRoute {
+  verb: string;
+  path: string;
+  invoke: Invoker;
+}
+
+const MISSING: WireReply = { status: 404, headers: { 'content-type': 'application/json' }, content: '{"message":"Not Found"}' };
+
+export class WebRouter extends Transport {
+  private readonly routes = new Map<string, MountedRoute>();
+
+  mount(bundles: EntryBundle[]): void {
+    for (const bundle of this.sortResources(bundles)) {
+      const { verb, path } = bundle.options as { verb: string; path?: string };
+      const route: MountedRoute = { verb, path: normalizePath(path ?? ''), invoke: this.buildInvoker(bundle) };
+      this.routes.set(`${route.verb} ${route.path}`, route);
+    }
+  }
+
+  dispatch(request: WireRequest): Promise<WireReply> {
+    const path = normalizePath(request.path.split('?')[0] ?? '');
+    const route = this.routes.get(`${request.verb} ${path}`) ?? this.routes.get(`ALL ${path}`);
+    if (!route) return Promise.resolve(MISSING);
+    return route.invoke(request);
+  }
+
+  routeTable(): string[] {
+    return [...this.routes.keys()].sort();
+  }
+
+  async close(): Promise<void> {
+    this.routes.clear();
+  }
+
+  private sortResources(bundles: EntryBundle[]): EntryBundle[] {
+    const order = (bundle: EntryBundle) => MetaStore.read<{ order: number }>(RESOURCE_KIND, bundle.unit.constructor)?.order ?? 0;
+    return bundles.filter(bundle => MetaStore.has(RESOURCE_KIND, bundle.unit.constructor)).sort((left, right) => order(left) - order(right));
+  }
+
+  private buildInvoker(bundle: EntryBundle): Invoker {
+    const slots = MetaStore.read<InputSlot[]>(INPUT_SLOTS, bundle.method) ?? [];
+    return async request => {
+      const reply = new ReplyHandle();
+      const args: unknown[] = [];
+      for (const slot of slots) args[slot.index] = this.argumentFor(slot, request, reply);
+      const pending = bundle.method.apply(bundle.unit, args);
+      if (reply.sent) return reply.toWire();
+      return toWire(await pending);
+    };
+  }
+
+  private argumentFor(slot: InputSlot, request: WireRequest, reply: ReplyHandle): unknown {
+    switch (slot.kind) {
+      case 'reply':
+        return reply;
+      case 'payload':
+        return request.payload;
+      case 'query':
+        return request.query?.[slot.name ?? ''];
+      case 'header':
+        return request.headers[slot.name ?? ''];
+    }
+  }
+}
+
+function normalizePath(path: string): string {
+  return `/${path}`.replace(/\/+/g, '/').replace(/(.)\/$/, '$1');
+}
