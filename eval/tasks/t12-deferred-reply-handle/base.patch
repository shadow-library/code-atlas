+export interface WireRequest {
+  verb: string;
+  path: string;
+  headers: Record<string, string | undefined>;
+  query?: Record<string, string>;
+  payload?: unknown;
+}
+
+export interface WireReply {
+  status: number;
+  headers: Record<string, string>;
+  content: string;
+}
+
+export const NO_CONTENT: WireReply = { status: 204, headers: {}, content: '' };
+
+export class ReplyHandle {
+  private code = 200;
+  private written: WireReply | undefined;
+
+  get sent(): boolean {
+    return this.written !== undefined;
+  }
+
+  status(code: number): this {
+    this.code = code;
+    return this;
+  }
+
+  send(content: string, contentType = 'text/plain; charset=utf-8'): void {
+    this.written = { status: this.code, headers: { 'content-type': contentType }, content };
+  }
+
+  toWire(): WireReply {
+    return this.written ?? NO_CONTENT;
+  }
+}
+
+export function toWire(result: unknown): WireReply {
+  if (result === undefined) return NO_CONTENT;
+  if (typeof result === 'string') return { status: 200, headers: { 'content-type': 'text/plain; charset=utf-8' }, content: result };
+  return { status: 200, headers: { 'content-type': 'application/json' }, content: JSON.stringify(result) };
+}
