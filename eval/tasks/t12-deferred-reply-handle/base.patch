@@ -0,0 +1,44 @@
+import { isSingleton } from './inject';
+import { Scanner } from './scanner';
+import { type Transport } from './transport';
+
+export interface KernelOptions {
+  transport: Transport;
+  units: Array<new () => object>;
+}
+
+export class Kernel {
+  private readonly scanner: Scanner;
+  private readonly instances = new Map<new () => object, object>();
+
+  private constructor(private readonly options: KernelOptions) {
+    this.scanner = new Scanner(this);
+  }
+
+  static boot(options: KernelOptions): Kernel {
+    const kernel = new Kernel(options);
+    for (const Type of options.units) kernel.load(Type);
+    return kernel;
+  }
+
+  get transport(): Transport {
+    return this.options.transport;
+  }
+
+  unit<T extends object>(type: new () => T): T | undefined {
+    return this.instances.get(type) as T | undefined;
+  }
+
+  shutdown(): Promise<void> {
+    this.instances.clear();
+    return this.options.transport.close();
+  }
+
+  private load(Type: new () => object): void {
+    const existing = this.instances.get(Type);
+    if (existing && isSingleton(Type)) return;
+    const instance = new Type();
+    this.instances.set(Type, instance);
+    this.scanner.collect(instance);
+  }
+}
diff --git a/corvid/packages/core/src/scanner.ts b/corvid/packages/core/src/scanner.ts
new file mode 100644
