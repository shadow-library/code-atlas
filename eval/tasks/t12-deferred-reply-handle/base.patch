--- /dev/null
+++ b/corvid/packages/core/src/scanner.ts
@@ -0,0 +1,23 @@
+import { MetaStore } from '@corvid/meta';
+
+import { ENTRY_KEY, UNIT_ENTRY_KEY } from './entry';
+import { type Kernel } from './kernel';
+import { type EntryBundle } from './transport';
+
+export class Scanner {
+  constructor(private readonly kernel: Kernel) {}
+
+  collect(unit: object): void {
+    const prototype = Object.getPrototypeOf(unit) as Record<string, unknown>;
+    const unitOptions = MetaStore.read<object>(UNIT_ENTRY_KEY, unit.constructor) ?? {};
+    const bundles: EntryBundle[] = [];
+    for (const property of Object.getOwnPropertyNames(prototype)) {
+      const method = prototype[property];
+      if (property === 'constructor' || typeof method !== 'function') continue;
+      const options = MetaStore.read<object>(ENTRY_KEY, method);
+      if (options) bundles.push({ unit, property, method: method as EntryBundle['method'], options: { ...unitOptions, ...options }, unitOptions });
+    }
+    const transport = this.kernel.transport;
+    transport.mount(bundles);
+  }
+}
