+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum DegradedCause {
+  ProjectConfigChanged,
+  UpdateFailed { error: String },
+  PartialRun { reason: String },
+  FilesNotIndexed { count: usize },
+}
+
+impl fmt::Display for DegradedCause {
+  fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+    match self {
+      Self::ProjectConfigChanged => f.write_str("project configuration changed; reopen the engine"),
+      Self::UpdateFailed { error } => write!(f, "index update failed: {error}"),
+      Self::PartialRun { reason } => f.write_str(reason),
+      Self::FilesNotIndexed { count } => write!(f, "{count} file(s) or repositories could not be indexed"),
+    }
+  }
+}
