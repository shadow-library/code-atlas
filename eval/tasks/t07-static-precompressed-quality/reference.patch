diff --git a/src/utils/compress.ts b/src/utils/compress.ts
index 4398173..86cee7d 100644
--- a/src/utils/compress.ts
+++ b/src/utils/compress.ts
@@ -3,8 +3,34 @@
  * Constants for compression.
  */
 
+import { parseAccept } from './accept'
+
 /**
  * Match for compressible content type.
  */
 export const COMPRESSIBLE_CONTENT_TYPE_REGEX =
   /^\s*(?:text\/(?!event-stream(?:[;\s]|$))[^;\s]+|application\/(?:javascript|json|xml|xml-dtd|ecmascript|dart|msgpack|postscript|rtf|tar|toml|vnd\.dart|vnd\.ms-fontobject|vnd\.ms-opentype|vnd\.msgpack|wasm|x-httpd-php|x-javascript|x-msgpack|x-ns-proxy-autoconfig|x-sh|x-tar|x-virtualbox-hdd|x-virtualbox-ova|x-virtualbox-ovf|x-virtualbox-vbox|x-virtualbox-vdi|x-virtualbox-vhd|x-virtualbox-vmdk|x-www-form-urlencoded)|font\/(?:otf|ttf)|image\/(?:bmp|vnd\.adobe\.photoshop|vnd\.microsoft\.icon|vnd\.ms-dds|x-icon|x-ms-bmp)|message\/rfc822|model\/gltf-binary|x-shader\/x-fragment|x-shader\/x-vertex|[^;\s]+?\+(?:json|text|xml|yaml|msgpack))(?:[;\s]|$)/i
+
+/**
+ * Order the candidate content codings by the client's Accept-Encoding preference.
+ * Codings the client refuses (q=0) or does not mention (without a wildcard) are dropped,
+ * and codings with the same quality keep the order of `candidates`.
+ */
+export const rankAcceptedEncodings = <T extends string>(
+  acceptEncoding: string | undefined,
+  candidates: readonly T[]
+): T[] => {
+  if (!acceptEncoding) {
+    return []
+  }
+  const accepts = parseAccept(acceptEncoding)
+  const wildcardQ = accepts.find((accept) => accept.type === '*')?.q ?? 0
+  return candidates
+    .map((encoding) => {
+      const explicit = accepts.find((accept) => accept.type.toLowerCase() === encoding)
+      return { encoding, q: explicit ? explicit.q : wildcardQ }
+    })
+    .filter(({ q }) => q > 0)
+    .sort((a, b) => b.q - a.q)
+    .map(({ encoding }) => encoding)
+}
