@@ -0,0 +1,27 @@
+export interface HttpRequest {
+  method: string;
+  url: string;
+  headers: Record<string, string | undefined>;
+  body?: unknown;
+}
+
+export interface HttpReply {
+  status: number;
+  headers: Record<string, string>;
+  body?: Buffer;
+  text?: string;
+}
+
+export class RawResponse {
+  constructor(
+    readonly contentType: string,
+    readonly text: string,
+  ) {}
+}
+
+export function toReply(result: unknown): HttpReply {
+  if (result instanceof RawResponse) return { status: 200, headers: { 'content-type': result.contentType }, text: result.text };
+  if (typeof result === 'string') return { status: 200, headers: { 'content-type': 'text/plain; charset=utf-8' }, text: result };
+  if (result === undefined) return { status: 204, headers: {} };
+  return { status: 200, headers: { 'content-type': 'application/json' }, body: Buffer.from(JSON.stringify(result)) };
+}
diff --git a/corvid/packages/http/src/module/http-router.ts b/corvid/packages/http/src/module/http-router.ts
new file mode 100644
index 0000000..0c39b7c
--- /dev/null
+++ b/corvid/packages/http/src/module/http-router.ts
@@ -0,0 +1,59 @@
+import { encodeBody, negotiateEncoding } from '../compression/content-encoding';
+import { CONTROLLER_METADATA, ROUTE_METADATA } from '../constants';
+import { type ControllerMetadata } from '../decorators/controller.decorator';
+import { type RouteMetadata } from '../decorators/route.decorator';
+import { type ServerOptions } from '../server.options';
+import { getMetadata } from '../store';
+import { type HttpReply, type HttpRequest, toReply } from './http-reply';
+
+type Handler = (request: HttpRequest) => unknown;
+
+interface RegisteredRoute {
+  method: string;
+  path: string;
+  handle: (request: HttpRequest) => Promise<HttpReply>;
+}
+
+const NOT_FOUND: HttpReply = { status: 404, headers: { 'content-type': 'application/json' }, body: Buffer.from('{"message":"Not Found"}') };
+
+export class HttpRouter {
+  private readonly routes = new Map<string, RegisteredRoute>();
+
+  constructor(private readonly options: ServerOptions) {}
+
+  register(controller: object): void {
+    const type = controller.constructor;
+    const prefix = getMetadata<ControllerMetadata>(CONTROLLER_METADATA, type)?.prefix ?? '';
+    for (const route of getMetadata<RouteMetadata[]>(ROUTE_METADATA, type) ?? []) {
+      const path = joinPath(prefix, route.path);
+      const handler = (controller as Record<string | symbol, Handler>)[route.handler].bind(controller);
+      this.routes.set(`${route.method} ${path}`, { method: route.method, path, handle: request => this.reply(request, handler) });
+    }
+  }
+
+  dispatch(request: HttpRequest): Promise<HttpReply> {
+    const route = this.routes.get(`${request.method} ${request.url.split('?')[0]}`);
+    if (!route) return Promise.resolve(NOT_FOUND);
+    return route.handle(request);
+  }
+
+  private async reply(request: HttpRequest, handler: Handler): Promise<HttpReply> {
+    const reply = toReply(await handler(request));
+    return this.compress(request, reply);
+  }
+
+  private compress(request: HttpRequest, reply: HttpReply): HttpReply {
+    const options = this.options.compression;
+    if (!options || reply.status === 204) return reply;
+    const encoding = negotiateEncoding(request.headers['accept-encoding'], options.encodings ?? ['br', 'gzip']);
+    const body = reply.body ?? Buffer.alloc(0);
+    if (!encoding || body.length < (options.threshold ?? 0)) return reply;
+    const headers = { ...reply.headers, 'content-encoding': encoding, vary: 'accept-encoding' };
+    return { status: reply.status, headers, body: encodeBody(body, encoding) };
+  }
+}
+
+function joinPath(prefix: string, path: string): string {
+  const joined = [prefix, path].filter(Boolean).join('/');
+  return `/${joined}`.replace(/\/+/g, '/');
+}
diff --git a/corvid/packages/http/src/module/http-server.ts b/corvid/packages/http/src/module/http-server.ts
