@@ -0,0 +1,29 @@
+import { ROUTE_METADATA } from '../constants';
+import { defineMetadata, getMetadata } from '../store';
+
+export type HttpMethod = 'GET' | 'POST' | 'PUT' | 'DELETE';
+
+export interface RouteMetadata {
+  method: HttpMethod;
+  path: string;
+  handler: string | symbol;
+}
+
+export function Route(method: HttpMethod, path = ''): MethodDecorator {
+  return (target, handler) => {
+    const routes = getMetadata<RouteMetadata[]>(ROUTE_METADATA, target.constructor) ?? [];
+    defineMetadata(ROUTE_METADATA, [...routes, { method, path, handler }], target.constructor);
+  };
+}
+
+export function Get(path = ''): MethodDecorator {
+  return Route('GET', path);
+}
+
+export function Post(path = ''): MethodDecorator {
+  return Route('POST', path);
+}
+
+export function Delete(path = ''): MethodDecorator {
+  return Route('DELETE', path);
+}
