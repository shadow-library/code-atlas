@@ -0,0 +1,20 @@
+import { brotliCompressSync, deflateSync, gzipSync } from 'node:zlib';
+
+export type ContentEncoding = 'br' | 'gzip' | 'deflate';
+
+export function negotiateEncoding(acceptEncoding: string | undefined, allowed: ContentEncoding[]): ContentEncoding | undefined {
+  if (!acceptEncoding) return undefined;
+  const offered = acceptEncoding.split(',').map(token => token.split(';')[0].trim().toLowerCase());
+  return allowed.find(encoding => offered.includes(encoding) || offered.includes('*'));
+}
+
+export function encodeBody(body: Buffer, encoding: ContentEncoding): Buffer {
+  switch (encoding) {
+    case 'br':
+      return brotliCompressSync(body);
+    case 'gzip':
+      return gzipSync(body);
+    case 'deflate':
+      return deflateSync(body);
+  }
+}
