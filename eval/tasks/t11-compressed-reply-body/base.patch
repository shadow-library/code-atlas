+export interface HttpClientOptions {
+  baseUrl: string;
+  acceptEncoding?: string;
+  timeoutMs?: number;
+}
+
+export class HttpClient {
+  constructor(private readonly options: HttpClientOptions) {}
+
+  async get<T>(path: string): Promise<T> {
+    const headers = { 'accept-encoding': this.options.acceptEncoding ?? '*' };
+    const response = await fetch(`${this.options.baseUrl}${path}`, { headers, signal: AbortSignal.timeout(this.options.timeoutMs ?? 5000) });
+    return (await response.json()) as T;
+  }
+
+  encodingOf(response: Response): string {
+    return response.headers.get('content-encoding') ?? 'none';
+  }
+}
