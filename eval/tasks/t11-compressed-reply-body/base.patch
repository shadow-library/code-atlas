+import { Controller, Get, type HttpRequest, Post, RawResponse } from '@corvid/http';
+
+import { FeedService } from './feed.service';
+
+@Controller('feeds')
+export class FeedController {
+  private readonly feeds = new FeedService();
+
+  @Get('sitemap')
+  sitemap(): RawResponse {
+    return new RawResponse('application/xml', this.feeds.sitemapXml());
+  }
+
+  @Post('ping')
+  ping(request: HttpRequest) {
+    const { url } = request.body as { url: string };
+    return { queued: this.feeds.queue(url) };
+  }
+}
