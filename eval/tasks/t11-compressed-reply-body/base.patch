@@ -0,0 +1,34 @@
+import { createServer, type IncomingMessage, type Server, type ServerResponse } from 'node:http';
+
+import { type ServerOptions } from '../server.options';
+import { type HttpReply, type HttpRequest } from './http-reply';
+import { HttpRouter } from './http-router';
+
+export class HttpServer {
+  private readonly router: HttpRouter;
+
+  private constructor(private readonly options: ServerOptions) {
+    this.router = new HttpRouter(options);
+  }
+
+  static create(options: ServerOptions): HttpServer {
+    const server = new HttpServer(options);
+    for (const Type of options.controllers) server.router.register(new Type());
+    return server;
+  }
+
+  inject(request: HttpRequest): Promise<HttpReply> {
+    return this.router.dispatch(request);
+  }
+
+  listen(): Server {
+    return createServer((request, response) => void this.handle(request, response)).listen(this.options.port);
+  }
+
+  private async handle(request: IncomingMessage, response: ServerResponse): Promise<void> {
+    const headers = Object.fromEntries(Object.entries(request.headers).map(([name, value]) => [name, Array.isArray(value) ? value.join(', ') : value]));
+    const reply = await this.router.dispatch({ method: request.method ?? 'GET', url: request.url ?? '/', headers });
+    response.writeHead(reply.status, reply.headers);
+    response.end(reply.body ?? reply.text);
+  }
+}
