+fn cwd_target(raw: &str, cwd: &Path, project: &Project) -> String {
+  let (location, line) = match raw.rsplit_once(':') {
+    Some((location, line)) if line.parse::<u32>().is_ok() => (location, Some(line)),
+    _ => (raw, None),
+  };
+  match (repo_relative(location, cwd, project), line) {
+    (Some((repo, path)), Some(line)) => format!("{repo}:{path}:{line}"),
+    (Some((repo, path)), None) => format!("{repo}:{path}"),
+    (None, _) => raw.to_owned(),
+  }
+}
+
