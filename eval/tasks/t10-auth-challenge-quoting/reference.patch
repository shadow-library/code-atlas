diff --git a/src/utils/quoted-string.ts b/src/utils/quoted-string.ts
new file mode 100644
index 0000000..0bb2a5d
--- /dev/null
+++ b/src/utils/quoted-string.ts
@@ -0,0 +1,11 @@
+/**
+ * @module
+ * HTTP quoted-string utility.
+ */
+
+/**
+ * Escape a value for use inside an HTTP quoted-string, such as an auth-param of a
+ * `WWW-Authenticate` challenge. Backslashes and double quotes are escaped with a
+ * backslash (RFC 9110, Section 5.6.4).
+ */
+export const escapeQuotedString = (value: string): string => value.replace(/[\\"]/g, '\\$&')
