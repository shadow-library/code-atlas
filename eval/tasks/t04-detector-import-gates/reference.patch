new file mode 100644
index 0000000..d40d158
--- /dev/null
+++ b/crates/atlas-detect/src/imports.rs
@@ -0,0 +1,50 @@
+use atlas_core::{ArgSummary, FileFacts, ImportFact};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum TsImportSyntax {
+  Esm,
+  Require,
+}
+
+pub(crate) fn ts_imports(facts: &FileFacts) -> impl Iterator<Item = (&str, TsImportSyntax)> {
+  facts.imports.iter().filter_map(|import| match import {
+    ImportFact::TsImport { specifier, .. } => Some((specifier.as_str(), TsImportSyntax::Esm)),
+    ImportFact::TsRequire {
+      specifier: ArgSummary::Str(specifier),
+      ..
+    } => Some((specifier.as_str(), TsImportSyntax::Require)),
+    _ => None,
+  })
+}
+
+pub(crate) fn ts_specifiers(facts: &FileFacts) -> impl Iterator<Item = &str> {
+  ts_imports(facts).map(|(specifier, _)| specifier)
+}
+
+pub(crate) fn esm_specifiers(facts: &FileFacts) -> impl Iterator<Item = &str> {
+  ts_imports(facts).filter(|(_, syntax)| *syntax == TsImportSyntax::Esm).map(|(specifier, _)| specifier)
+}
+
+pub(crate) fn rust_use_roots(facts: &FileFacts) -> impl Iterator<Item = &str> {
+  facts
+    .imports
+    .iter()
+    .filter_map(|import| match import {
+      ImportFact::RustUse { paths, .. } => Some(paths),
+      _ => None,
+    })
+    .flatten()
+    .filter_map(|path| path.segments.first().map(String::as_str))
+}
+
+pub(crate) fn rust_extern_crates(facts: &FileFacts) -> impl Iterator<Item = &str> {
+  facts.imports.iter().filter_map(|import| match import {
+    ImportFact::RustExternCrate { name, .. } => Some(name.as_str()),
+    _ => None,
+  })
+}
+
+pub(crate) fn mentions_rust_crate(facts: &FileFacts, crates: &[&str]) -> bool {
+  let reference_roots = facts.references.iter().filter_map(|reference| reference.path.first().map(String::as_str));
+  rust_use_roots(facts).chain(reference_roots).any(|root| crates.contains(&root))
+}
